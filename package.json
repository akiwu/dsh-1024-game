{
  "name": "dsh-1024-game",
  "version": "0.2.0",
  "description": "在 DeepSeek Harness Web GUI 里玩 1024：侧边栏入口 + 全屏游戏面板，方向键/WASD/滑动操作，本地保存最高分与进度。",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "client-plugin",
    "2048",
    "1024",
    "game"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "assets",
    "docs/screenshots",
    "INSTALL.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "preview": "node preview/build.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akiwu/dsh-1024-game.git"
  },
  "homepage": "https://github.com/akiwu/dsh-1024-game",
  "bugs": {
    "url": "https://github.com/akiwu/dsh-1024-game/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
